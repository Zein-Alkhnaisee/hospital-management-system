.services-section {
  padding: 60px 20px;
  text-align: center;
  width: 100%;
  margin-top: 5.5rem;
}

.services-title {
  font-size: 32px;
  margin-bottom: 40px;
}

.service-desc {
  font-size: 14px;
  margin-top: 8px;
  text-align: center;
  padding: 0 10px;
}

.services-filters {
  display: flex;
  justify-content: center;
  gap: 1rem;
  margin-bottom: 4rem;
}
.filter-btn {
  padding: 8px 16px;
  border: none;
  background-color: #eee;
  cursor: pointer;
  border-radius: 20px;
  font-size: 13px;
  font-weight: 600;
  transition: all 0.5s;
}

.filter-btn:hover {
  background-color: var(--primary-hover);
}

.filter-btn.active {
  background-color: var(--primary-color);
  color: white;
}

.services-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  gap: 20px;
}

.service-card {
  position: relative;
  background-size: cover;
  background-position: center;
  min-height: 250px;
  border-radius: 16px;
  overflow: hidden;
  transition: transform 0.3s ease;
}

.service-card:hover {
  transform: scale(1.03);
}

.service-overlay {
  background: #4da6ffc4;
  color: white;
  height: 50vh;
  width: 100%;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  gap: 15px;
  border-radius: 15px;
}
.service-overlay:hover {
  color: black;
}
.service-icon {
  font-size: 40px;
  margin-bottom: 10px;
  /* color: var(--title-color); */
  color: white;
  transition: color 1s ease-in-out;
}

.service-card:hover .service-icon {
  animation: pulse 0.6s ease-in-out;
  /* color: var(--primary-hover); */
  color: white;
}

.service-title {
  font-size: 20px;
}

.one,
.two,
.three,
.four,
.five,
.sex {
  transition: background 4s cubic-bezier(0.61, 0.02, 0.38, 0.97), color 3s ease;
}
.one:hover,
.two:hover,
.three:hover,
.four:hover,
.five:hover,
.sex:hover {
  background-size: cover;
  background-position: center;
  /* color: var(--primary-color); */
  color: white;
}
.one:hover {
  background-image: url("./../../assets/images/1746111149891.jpg");
}
.two:hover {
  background-image: url("./../../assets/images/1746108227843.jpg");
}
.three:hover {
  background-image: url("./../../assets/images/car.jpg");
}
.four:hover {
  background-image: url("./../../assets/images/doctor/CardiacCare.jpg");
}
.five:hover {
  background-image: url("./../../assets/images/doctor/HomeNursing.jpg");
}
.sex:hover {
  background-image: url("./../../assets/images/doctor/MedicalRecords.jpg");
}
@keyframes pulse {
  0% {
    transform: scale(1);
  }
  50% {
    transform: scale(1.4);
  }
  100% {
    transform: scale(1);
  }
}
