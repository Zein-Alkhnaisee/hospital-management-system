.features-section {
  padding: 80px 20px;
  text-align: center;
  border-bottom: 1px solid var(--title-color);
}
  
.features-container {
  max-width: 1100px;
  margin: auto;
}
  
.features-section h2 {
  font-size: 2.3rem;
  color: var(--title-color);
  margin-bottom: 50px;
}
  
.features-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 30px;
  justify-content: center;
}
  
.feature-card {
  background-color: white;
  border-radius: 15px;
  padding: 30px 20px;
  box-shadow: 0 4px 15px rgba(0,0,0,0.1);
  flex: 1 1 300px;
  transition: transform 0.3s ease;
}
  
.feature-card:hover {
  transform: translateY(-10px);
}
  
.feature-card i {
  font-size: 40px;
  color: var(--primary-color);
  margin-bottom: 20px;
}
  
.feature-card h3 {
  font-size: 1.3rem;
  margin-bottom: 15px;
  color: #333;
}
  
.feature-card p {
  color: #555;
  font-size: 1rem;
  line-height: 1.6;
}